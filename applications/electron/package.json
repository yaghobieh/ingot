{
  "private": true,
  "name": "@ingot/electron-app",
  "productName": "Ingot",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "main": "lib/backend/electron-main.js",
  "dependencies": {
    "@theia/core": "1.76.0",
    "@theia/editor": "1.76.0",
    "@theia/filesystem": "1.76.0",
    "@theia/markers": "1.76.0",
    "@theia/messages": "1.76.0",
    "@theia/monaco": "1.76.0",
    "@theia/navigator": "1.76.0",
    "@theia/preferences": "1.76.0",
    "@theia/process": "1.76.0",
    "@theia/terminal": "1.76.0",
    "@theia/workspace": "1.76.0",
    "@theia/search-in-workspace": "1.76.0",
    "@theia/file-search": "1.76.0",
    "@theia/keymaps": "1.76.0",
    "@theia/outline-view": "1.76.0",
    "@theia/output": "1.76.0",
    "@theia/debug": "1.76.0",
    "@theia/scm": "1.76.0",
    "@theia/vsx-registry": "1.76.0",
    "@theia/plugin-ext": "1.76.0",
    "@theia/plugin-ext-vscode": "1.76.0",
    "@theia/variable-resolver": "1.76.0",
    "@theia/task": "1.76.0",
    "@theia/userstorage": "1.76.0",
    "@theia/editor-preview": "1.76.0",
    "@theia/console": "1.76.0",
    "@theia/bulk-edit": "1.76.0",
    "@theia/callhierarchy": "1.76.0",
    "@theia/typehierarchy": "1.76.0",
    "@theia/notebook": "1.76.0",
    "@theia/timeline": "1.76.0",
    "@theia/property-view": "1.76.0",
    "@ingot/core": "0.1.0",
    "@theia/electron": "1.76.0"
  },
  "devDependencies": {
    "@theia/cli": "1.76.0",
    "electron": "42.8.1"
  },
  "scripts": {
    "bundle": "npm run rebuild && theia build --mode production",
    "rebuild": "theia rebuild:electron --cacheRoot ../..",
    "start": "theia start --plugins=local-dir:../../plugins",
    "watch": "theia build --watch --mode development",
    "clean": "theia clean"
  },
  "theia": {
    "target": "electron",
    "frontend": {
      "config": {
        "applicationName": "Ingot",
        "defaultTheme": {
          "light": "ingot-light",
          "dark": "ingot-dark"
        },
        "defaultIconTheme": "none",
        "reloadOnReconnect": true,
        "preferences": {
          "security.workspace.trust.enabled": false,
          "git.openRepositoryInParentFolders": "never",
          "window.title": "${dirty}${appName}${separator}${rootName}${separator}${activeEditorShort}",
          "workbench.colorTheme": "ingot-light",
          "workbench.iconTheme": "ingot-badges",
          "window.titleBarStyle": "custom",
          "files.enableTrash": false,
          "breadcrumbs.enabled": true,
          "editor.fontFamily": "'JetBrains Mono', Menlo, Consolas, monospace",
          "editor.fontSize": 13,
          "editor.lineHeight": 20,
          "editor.minimap.enabled": false,
          "editor.renderLineHighlight": "all",
          "terminal.integrated.fontFamily": "'JetBrains Mono', Menlo, Consolas, monospace",
          "terminal.integrated.fontSize": 13,
          "workbench.tree.indent": 12,
          "workbench.statusBar.visible": true
        },
        "electron": {
          "showWindowEarly": true,
          "splashScreenOptions": {
            "content": "resources/splash.svg",
            "width": 480,
            "height": 300
          }
        }
      }
    },
    "backend": {
      "config": {
        "configurationFolder": ".ingot",
        "startupTimeout": -1,
        "frontendConnectionTimeout": -1
      }
    },
    "generator": {
      "config": {
        "preloadTemplate": "./resources/preload.html"
      }
    }
  }
}
