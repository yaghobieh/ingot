              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/keys",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "keys"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"family\": \"claude\",\n  \"label\": \"My key\",\n  \"secret\": \"<your key>\"\n}"
            }
          }
        }
      ]
    },
