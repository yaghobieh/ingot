{
  "info": {
    "name": "Ingot Portal API (0.1.0)",
    "description": "REST API used by the Ingot IDE and the portal. Auth: browser session cookie or `Authorization: Bearer {{accessToken}}` (an ingot_pat_ token from device sign-in or the API keys page). Never commit real tokens.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3200"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "deviceCode",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Device sign-in (IDE)",
      "item": [
        {
          "name": "Start device authorization",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/device/code",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "device",
                "code"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clientName\": \"Ingot IDE\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Poll for token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/device/token",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "device",
                "token"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"device_code\": \"{{deviceCode}}\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          }
        }
      ]
    },
    {
      "name": "Account",
      "item": [
        {
          "name": "Get me",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "me"
              ]
            }
          }
        },
        {
          "name": "Update profile",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "me"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ada\",\n  \"theme\": \"dark\",\n  \"locale\": \"en\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Usage",
      "item": [
        {
          "name": "Usage summary",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/usage?days=30",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "usage"
              ],
              "query": [
                {
                  "key": "days",
                  "value": "30"
                }
              ]
            }
          }
        },
        {
          "name": "Usage rows",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/usage?view=rows&days=30&page=0",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "usage"
              ],
              "query": [
                {
                  "key": "view",
                  "value": "rows"
                },
                {
                  "key": "days",
                  "value": "30"
                },
                {
                  "key": "page",
                  "value": "0"
                }
              ]
            }
          }
        },
        {
          "name": "Report usage",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/usage",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "usage"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"events\": [\n    {\n      \"model\": \"claude-sonnet-4.5\",\n      \"feature\": \"agent\",\n      \"requests\": 1,\n      \"inputTokens\": 1200,\n      \"outputTokens\": 300,\n      \"costUsd\": 0.012\n    }\n  ]\n}"
            }
          }
        },
        {
          "name": "Export CSV",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/usage/export?days=30",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "usage",
                "export"
              ],
              "query": [
                {
                  "key": "days",
                  "value": "30"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Settings sync",
      "item": [
        {
          "name": "Get settings",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/settings",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "settings"
              ]
            }
          }
        },
        {
          "name": "Patch settings",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/settings",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "settings"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"data\": {\n    \"editor.fontSize\": 13\n  },\n  \"baseVersion\": 0\n}"
            }
          }
        }
      ]
    },
