{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Hello fixture",
  "type": "object",
  "properties": {
    "name": { "type": "string", "description": "Project name." },
    "greeting": { "type": "string", "description": "Text the fixture prints when it runs." },
    "count": { "type": "integer", "description": "How many times to greet." },
    "languages": { "type": "array", "items": { "type": "string" }, "description": "Languages the fixture covers." }
  }
}
